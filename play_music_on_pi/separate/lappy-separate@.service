# Live separation on boot. Template: the instance name is the user, whose
# ~/demucs_opt is run. Install: setup_pi.sh (enables, does not start).
#   sudo systemctl start|stop|status lappy-separate@$USER
#   journalctl -u lappy-separate@$USER -f
#   sudo systemctl disable lappy-separate@$USER      # stop launching at boot

[Unit]
Description=lappy-lemon live stem separation (%i)
After=sound.target

[Service]
User=%i
WorkingDirectory=/home/%i/demucs_opt
Environment=PYTHONPATH=stubs PYTHONUNBUFFERED=1
# HAT probes after sound.target on some boots; wait for the card.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /proc/asound/Zero ] && exit 0; sleep 1; done; exit 1'
ExecStart=/home/%i/demucs_opt/.venv/bin/python separate/separate_stream.py --model student_final_slim.onnx --repo . --threads 4 --fader-viz off
# SIGINT = Ctrl-C: runs the ordered shutdown (killing ORT mid-Run aborts).
KillSignal=SIGINT
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
